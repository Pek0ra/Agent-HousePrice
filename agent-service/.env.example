# The skeleton works without a model key. Configure it before connecting an LLM.
OPENAI_API_KEY=change_this
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_CONFIDENCE_THRESHOLD=0.7
JEV_NOUL_MARGIN=0.15
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:9900,http://127.0.0.1:9900
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=house_price
MYSQL_USERNAME=house_agent_ro
MYSQL_PASSWORD=change_this_password
AUDIT_MYSQL_USERNAME=house_agent_audit
AUDIT_MYSQL_PASSWORD=change_this_agent_audit_password
SQL_MAX_ROWS=100
SQL_EXECUTION_TIMEOUT_MS=5000
SQL_MAX_REPAIR_ATTEMPTS=1
TOOL_MAX_MODEL_CALLS=6
MODEL_MAX_CALLS_PER_TURN=8
TOOL_MAX_CALLS=8
CHECKPOINT_DB_PATH=data/checkpoints/agent_checkpoints.sqlite
CONVERSATION_HISTORY_MAX_MESSAGES=8
CONVERSATION_HISTORY_MAX_CHARS=6000
LANGGRAPH_STRICT_MSGPACK=true
BIG_DATA_ENABLED=false
HIVE_HOST=127.0.0.1
HIVE_PORT=10001
HIVE_DATABASE=mydb
HIVE_USERNAME=hive
HIVE_AUTH=NONE
