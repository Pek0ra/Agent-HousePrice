# The skeleton works without a model key. Configure it before connecting an LLM.
OPENAI_API_KEY=change_this
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:9900,http://127.0.0.1:9900
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=house_price
MYSQL_USERNAME=house_agent_ro
MYSQL_PASSWORD=change_this_password
AUDIT_MYSQL_USERNAME=house_agent_audit
AUDIT_MYSQL_PASSWORD=change_this_agent_audit_password
SQL_MAX_ROWS=100
SQL_EXECUTION_TIMEOUT_MS=5000
SQL_MAX_REPAIR_ATTEMPTS=1
