# Copy this file to .env and replace the password before starting MySQL.
MYSQL_PASSWORD=change_this_password
MYSQL_PORT=3306

# Java reads these values from the IDE run configuration or host environment.
MYSQL_URL=jdbc:mysql://localhost:3306/house_price?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_0900_ai_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
BIG_DATA_ENABLED=false

# Python Agent model and isolated database credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
AGENT_MYSQL_PASSWORD=change_this_agent_readonly_password
AGENT_AUDIT_MYSQL_PASSWORD=change_this_agent_audit_password
SQL_MAX_ROWS=100
SQL_EXECUTION_TIMEOUT_MS=5000
SQL_MAX_REPAIR_ATTEMPTS=1
