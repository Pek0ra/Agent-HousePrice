# Copy this file to .env and replace the password before starting MySQL.
MYSQL_PASSWORD=change_this_password
MYSQL_PORT=3307
FRONTEND_PORT=80

# Java reads these values from the IDE run configuration or host environment.
MYSQL_URL=jdbc:mysql://localhost:3306/house_price?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_0900_ai_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
BIG_DATA_ENABLED=false

# Python Agent model and isolated database credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
AGENT_MYSQL_PASSWORD=change_this_agent_readonly_password
AGENT_AUDIT_MYSQL_PASSWORD=change_this_agent_audit_password
IMPORT_MYSQL_PASSWORD=change_this_import_writer_password
IMPORT_MYSQL_URL=jdbc:mysql://localhost:3306/house_price?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_0900_ai_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
IMPORT_MYSQL_USERNAME=house_import_writer
SQL_MAX_ROWS=100
SQL_EXECUTION_TIMEOUT_MS=5000
SQL_MAX_REPAIR_ATTEMPTS=1
CHECKPOINT_DB_PATH=/data/checkpoints/agent_checkpoints.sqlite
CONVERSATION_HISTORY_MAX_MESSAGES=8
CONVERSATION_HISTORY_MAX_CHARS=6000

# Big-data profile. Keep false/local for the core profile.
JAVA_MAVEN_PROFILE=local
SPRING_PROFILES_ACTIVE=local
HIVE_SERVER2_PORT=10001
HIVE_SERVER2_WEB_PORT=10002
HIVE_METASTORE_PORT=9083
HDFS_NAMENODE_RPC_PORT=8020
HDFS_NAMENODE_WEB_PORT=9870
HDFS_DATANODE_WEB_PORT=9864
HIVE_URL=jdbc:hive2://hiveserver2:10000/mydb
HIVE_HOST=hiveserver2
HIVE_INTERNAL_PORT=10000
HIVE_DATABASE=mydb
HIVE_USERNAME=hive
HIVE_PASSWORD=
HIVE_AUTH=NONE
HDFS_WEB_URL=http://namenode:9870
HDFS_USER=hive
HDFS_BASE_PATH=/data/house/normalized
